# XCli environment configuration example.
# Copy this to .env and fill in values as needed.
# All variables are optional — defaults are shown in comments.

# Path to the persistent Chrome user-data directory.
# Default: ~/.xcli/profile
# XCLI_USER_DATA_DIR=~/.xcli/profile

# Run browser in headless mode. Set to "false" to see the browser window.
# Default: true
# XCLI_HEADLESS=true

# Logging verbosity. One of: DEBUG, INFO, WARNING, ERROR
# Default: WARNING
# XCLI_LOG_LEVEL=WARNING

# Browser operation timeout in milliseconds.
# Default: 5000
# XCLI_TIMEOUT_MS=5000

# Navigation delay between page loads in seconds (human pacing).
# Default: 2.0
# XCLI_NAV_DELAY_S=2.0

# Path to a custom Chrome/Chromium executable.
# Leave unset to use the Patchright-managed browser.
# XCLI_CHROME_PATH=/usr/bin/google-chrome

# Set to "1" or "true" to enable live (E2E) tests that hit real X.com.
# WARNING: Live tests use a real account. Never enable in CI.
# Default: unset (live tests skipped)
# XCLI_LIVE=1
